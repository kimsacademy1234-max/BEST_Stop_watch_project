     // ---------------------------------------------------------------- 클럭 · tick
@@ -262,10 +264,19 @@
         .i_wt_cursor(w_wt_cursor),
         .i_sel_wt   (w_sel_wt),        // (10/16) 시계 화면에서만 설정 점멸
         .i_set_sw2  (set_sw2),
-        .o_fnd_com  (fnd_com),
