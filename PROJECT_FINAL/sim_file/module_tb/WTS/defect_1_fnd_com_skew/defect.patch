         .o_fnd_font (fnd_font)
     );
 
+    // [FAULT-INJ F1] com 위상 지연 주입기: U_FND_CONTROLLER.o_fnd_com → 주입기 → 핀 fnd_com
+    fault_com_skew #(.N(12500)) U_FAULT_COM_SKEW (  // [FAULT-INJ F1]
+        .i_clk       (clk),                         // [FAULT-INJ F1]
+        .i_rst       (rst),                         // [FAULT-INJ F1]
+        .i_fault_sw15(fault_sw15),                  // [FAULT-INJ F1]
+        .i_fnd_com   (w_fnd_com_raw),               // [FAULT-INJ F1]
+        .o_fnd_com   (fnd_com)                      // [FAULT-INJ F1]
+    );                                              // [FAULT-INJ F1]
+
     // ---------------------------------------------------------------- LED (assign)
     assign w_alarm_blink = (w_wt_msec >= 50);
     assign led[0]    = (w_tm_alarm) ? w_alarm_blink : w_sel_wt;                               // 시계
