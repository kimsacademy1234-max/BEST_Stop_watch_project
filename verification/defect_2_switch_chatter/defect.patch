@@ -90,32 +91,42 @@
 
 
 
+    // [FAULT-INJ F2] 채터링/노이즈 주입기: 버튼 핀 → 주입기 → 디바운서
+    wire w_btnR_inj, w_btnL_inj, w_btnU_inj, w_btnD_inj;   // [FAULT-INJ F2]
+    fault_chatter U_FAULT_CHATTER (                        // [FAULT-INJ F2]
+        .clk     (clk),                                    // [FAULT-INJ F2]
+        .rst     (rst),                                    // [FAULT-INJ F2]
+        .sw_fault(sw_fault),                               // [FAULT-INJ F2]
+        .i_btn   ({btnD, btnU, btnL, btnR}),               // [FAULT-INJ F2]
+        .o_btn   ({w_btnD_inj, w_btnU_inj, w_btnL_inj, w_btnR_inj})  // [FAULT-INJ F2]
+    );                                                     // [FAULT-INJ F2]
+
     btn_debounce U_BD_R (
         .clk_remake(w_clk_4Khz),
         .clk  (clk),
         .reset(rst),
-        .i_btn(btnR),
+        .i_btn(w_btnR_inj),   // [FAULT-INJ F2] 원래 btnR
         .o_btn(w_btnR)
     );
     btn_debounce U_BD_L (
         .clk_remake(w_clk_4Khz),
         .clk  (clk),
         .reset(rst),
-        .i_btn(btnL),
+        .i_btn(w_btnL_inj),   // [FAULT-INJ F2] 원래 btnL
         .o_btn(w_btnL)
     );
     btn_debounce U_BD_U (
         .clk_remake(w_clk_4Khz),
         .clk  (clk),
         .reset(rst),
-        .i_btn(btnU),
+        .i_btn(w_btnU_inj),   // [FAULT-INJ F2] 원래 btnU
         .o_btn(w_btnU)
     );
     btn_debounce U_BD_D (
         .clk_remake(w_clk_4Khz),
         .clk  (clk),
         .reset(rst),
-        .i_btn(btnD),
+        .i_btn(w_btnD_inj),   // [FAULT-INJ F2] 원래 btnD
         .o_btn(w_btnD)
     );
 
