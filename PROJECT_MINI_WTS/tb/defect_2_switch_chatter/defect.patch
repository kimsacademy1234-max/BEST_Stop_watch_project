     // ---------------------------------------------------------------- 디바운서
+    // [FAULT-INJ F2] 채터링/노이즈 주입기: 버튼 핀 → 주입기 → 디바운서
+    wire w_btn_R_inj, w_btn_L_inj, w_btn_U_inj, w_btn_D_inj;  // [FAULT-INJ F2]
+    fault_chatter U_FAULT_CHATTER (                           // [FAULT-INJ F2]
