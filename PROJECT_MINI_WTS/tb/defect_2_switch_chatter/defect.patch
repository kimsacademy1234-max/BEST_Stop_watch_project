+        .i_rst       (rst),                                   // [FAULT-INJ F2]
+        .i_fault_sw15(fault_sw15),                            // [FAULT-INJ F2]
+        .i_btn       ({btn_D, btn_U, btn_L, btn_R}),          // [FAULT-INJ F2]
+        .o_btn       ({w_btn_D_inj, w_btn_U_inj, w_btn_L_inj, w_btn_R_inj})  // [FAULT-INJ F2]
+    );                                                        // [FAULT-INJ F2]
     btn_debounce U_BD_R (
         .i_clk     (clk),
         .i_rst     (rst),
         .i_clk_4khz(w_clk_4khz),
-        .i_btn     (btn_R),
+        .i_btn     (w_btn_R_inj),   // [FAULT-INJ F2] 원래 btn_R
         .o_btn     (w_btn_R)
     );
     btn_debounce U_BD_L (
         .i_clk     (clk),
         .i_rst     (rst),
         .i_clk_4khz(w_clk_4khz),
-        .i_btn     (btn_L),
+        .i_btn     (w_btn_L_inj),   // [FAULT-INJ F2] 원래 btn_L
         .o_btn     (w_btn_L)
     );
     btn_debounce U_BD_U (
         .i_clk     (clk),
         .i_rst     (rst),
         .i_clk_4khz(w_clk_4khz),
-        .i_btn     (btn_U),
+        .i_btn     (w_btn_U_inj),   // [FAULT-INJ F2] 원래 btn_U
         .o_btn     (w_btn_U)
     );
     btn_debounce U_BD_D (
         .i_clk     (clk),
         .i_rst     (rst),
         .i_clk_4khz(w_clk_4khz),
-        .i_btn     (btn_D),
+        .i_btn     (w_btn_D_inj),   // [FAULT-INJ F2] 원래 btn_D
         .o_btn     (w_btn_D)
     );
 
